<?xml version='1.0' encoding='utf-8'?>
<widget id="io.github.pandadesigner.todonotebook" version="1.0.0" android-versionCode="1" ios-CFBundleVersion="1" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Todo Notebook</name>
    <description>Scaffolding de Todo Notebook</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <!-- scheme y hostname fijan el origen de Ionic Storage. No cambiarlos después de guardar datos reales. -->
    <preference name="scheme" value="app" />
    <preference name="hostname" value="localhost" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="AndroidXEnabled" value="true" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/android/splash-icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#3A2E5C" />
        <icon density="ldpi" background="resources/android/adaptive/ldpi-background.png" foreground="resources/android/adaptive/ldpi-foreground.png" src="resources/android/icon/ldpi.png" />
        <icon density="mdpi" background="resources/android/adaptive/mdpi-background.png" foreground="resources/android/adaptive/mdpi-foreground.png" src="resources/android/icon/mdpi.png" />
        <icon density="hdpi" background="resources/android/adaptive/hdpi-background.png" foreground="resources/android/adaptive/hdpi-foreground.png" src="resources/android/icon/hdpi.png" />
        <icon density="xhdpi" background="resources/android/adaptive/xhdpi-background.png" foreground="resources/android/adaptive/xhdpi-foreground.png" src="resources/android/icon/xhdpi.png" />
        <icon density="xxhdpi" background="resources/android/adaptive/xxhdpi-background.png" foreground="resources/android/adaptive/xxhdpi-foreground.png" src="resources/android/icon/xxhdpi.png" />
        <icon density="xxxhdpi" background="resources/android/adaptive/xxxhdpi-background.png" foreground="resources/android/adaptive/xxxhdpi-foreground.png" src="resources/android/icon/xxxhdpi.png" />
        <splash src="resources/splash.png" />
    </platform>
    <platform name="ios">
        <preference name="deployment-target" value="15.0" />
        <preference name="StatusBarOverlaysWebView" value="false" />
        <preference name="StatusBarBackgroundColor" value="#4b3f6b" />
        <preference name="BackgroundColor" value="#3A2E5C" />
        <icon src="resources/ios/icon/icon-1024.png" width="1024" height="1024" />
        <icon src="resources/ios/icon/icon-180.png" width="180" height="180" />
        <icon src="resources/ios/icon/icon-167.png" width="167" height="167" />
        <icon src="resources/ios/icon/icon-152.png" width="152" height="152" />
        <icon src="resources/ios/icon/icon-120.png" width="120" height="120" />
        <icon src="resources/ios/icon/icon-114.png" width="114" height="114" />
        <icon src="resources/ios/icon/icon-87.png" width="87" height="87" />
        <icon src="resources/ios/icon/icon-80.png" width="80" height="80" />
        <icon src="resources/ios/icon/icon-76.png" width="76" height="76" />
        <icon src="resources/ios/icon/icon-60.png" width="60" height="60" />
        <icon src="resources/ios/icon/icon-58.png" width="58" height="58" />
        <icon src="resources/ios/icon/icon-40.png" width="40" height="40" />
        <icon src="resources/ios/icon/icon-29.png" width="29" height="29" />
        <icon src="resources/ios/icon/icon-20.png" width="20" height="20" />
        <splash src="resources/ios/splash/Default@2x~universal~anyany.png" />
    </platform>
</widget>
