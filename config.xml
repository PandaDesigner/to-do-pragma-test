<?xml version='1.0' encoding='utf-8'?>
<widget android-versionCode="1" id="io.github.pandadesigner.todonotebook" ios-CFBundleVersion="1" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Todo Notebook</name>
    <description>Scaffolding de Todo Notebook</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    <plugin name="cordova-sqlite-storage" spec="^7.0.0" />
    <preference name="scheme" value="app" />
    <preference name="hostname" value="localhost" />
    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />
        <preference name="AndroidXEnabled" value="true" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="resources/android/splash-icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#3A2E5C" />
        <icon background="resources/android/adaptive/ldpi-background.png" density="ldpi" foreground="resources/android/adaptive/ldpi-foreground.png" src="resources/android/icon/ldpi.png" />
        <icon background="resources/android/adaptive/mdpi-background.png" density="mdpi" foreground="resources/android/adaptive/mdpi-foreground.png" src="resources/android/icon/mdpi.png" />
        <icon background="resources/android/adaptive/hdpi-background.png" density="hdpi" foreground="resources/android/adaptive/hdpi-foreground.png" src="resources/android/icon/hdpi.png" />
        <icon background="resources/android/adaptive/xhdpi-background.png" density="xhdpi" foreground="resources/android/adaptive/xhdpi-foreground.png" src="resources/android/icon/xhdpi.png" />
        <icon background="resources/android/adaptive/xxhdpi-background.png" density="xxhdpi" foreground="resources/android/adaptive/xxhdpi-foreground.png" src="resources/android/icon/xxhdpi.png" />
        <icon background="resources/android/adaptive/xxxhdpi-background.png" density="xxxhdpi" foreground="resources/android/adaptive/xxxhdpi-foreground.png" src="resources/android/icon/xxxhdpi.png" />
        <splash src="resources/splash.png" />
    </platform>
    <platform name="ios">
        <preference name="deployment-target" value="15.0" />
        <preference name="StatusBarOverlaysWebView" value="false" />
        <preference name="StatusBarBackgroundColor" value="#4b3f6b" />
        <preference name="BackgroundColor" value="#3A2E5C" />
        <icon height="1024" src="resources/ios/icon/icon-1024.png" width="1024" />
        <icon height="180" src="resources/ios/icon/icon-180.png" width="180" />
        <icon height="167" src="resources/ios/icon/icon-167.png" width="167" />
        <icon height="152" src="resources/ios/icon/icon-152.png" width="152" />
        <icon height="120" src="resources/ios/icon/icon-120.png" width="120" />
        <icon height="114" src="resources/ios/icon/icon-114.png" width="114" />
        <icon height="87" src="resources/ios/icon/icon-87.png" width="87" />
        <icon height="80" src="resources/ios/icon/icon-80.png" width="80" />
        <icon height="76" src="resources/ios/icon/icon-76.png" width="76" />
        <icon height="60" src="resources/ios/icon/icon-60.png" width="60" />
        <icon height="58" src="resources/ios/icon/icon-58.png" width="58" />
        <icon height="40" src="resources/ios/icon/icon-40.png" width="40" />
        <icon height="29" src="resources/ios/icon/icon-29.png" width="29" />
        <icon height="20" src="resources/ios/icon/icon-20.png" width="20" />
        <splash src="resources/ios/splash/Default@2x~universal~anyany.png" />
    </platform>
</widget>
