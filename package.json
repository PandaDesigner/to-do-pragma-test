{
  "name": "todo-notebook",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --runInBand",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{json,js,cjs}\" \".github/**/*.{yml,md}\" README.md",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"*.{json,js,cjs}\" \".github/**/*.{yml,md}\" README.md",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "clean:platforms": "node scripts/clean-cordova-platforms.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "trace:check": "node scripts/trace-check.mjs",
    "build:android": "ng build && cordova build android --debug",
    "build:android:release": "ng build --configuration production && ionic cordova build android --release -- -- --keystore=$ANDROID_KEYSTORE_PATH --alias=$ANDROID_KEY_ALIAS --storePassword=$ANDROID_KEYSTORE_PASSWORD --password=$ANDROID_KEY_ALIAS_PASSWORD",
    "build:ios": "node scripts/build-ios-archive.cjs",
    "requirements": "cordova requirements --verbose",
    "ionic:serve": "ng serve",
    "ionic:build": "node scripts/ionic-build.cjs",
    "ionic:build:android": "node scripts/build-android-release.cjs"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11 <12"
  },
  "cordova": {
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": {
      "cordova-sqlite-storage": {}
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@ionic/angular": "8.8.19",
    "@ionic/storage": "4.0.0",
    "@ionic/storage-angular": "^4.0.0",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "firebase": "^13.0.0",
    "ionicons": "^8.1.0",
    "localforage-cordovasqlitedriver": "^1.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "^7.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.5.0",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.1.1",
    "cordova-sqlite-storage": "^7.0.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0"
  },
  "description": "Todo Notebook: scaffolding Ionic Angular standalone con Cordova"
}
