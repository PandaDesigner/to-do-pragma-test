{
  "name": "todo-notebook",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --runInBand",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{json,js,cjs}\" \".github/**/*.{yml,md}\" README.md",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"*.{json,js,cjs}\" \".github/**/*.{yml,md}\" README.md",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "ionic:serve": "ng serve"
  },
  "private": true,
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11 <12"
  },
  "cordova": {
    "plugins": {
      "cordova-sqlite-storage": {}
    },
    "platforms": []
  },
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@ionic/angular": "8.8.19",
    "@ionic/storage": "4.0.0",
    "@ionic/storage-angular": "^4.0.0",
    "@ngrx/signals": "^22.0.1",
    "firebase": "^13.0.0",
    "ionicons": "^8.1.0",
    "localforage-cordovasqlitedriver": "^1.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/cli": "^7.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.5.0",
    "cordova": "^13.0.0",
    "cordova-sqlite-storage": "^7.0.0",
    "eslint": "^10.10.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0"
  },
  "description": "Todo Notebook: scaffolding Ionic Angular standalone con Cordova"
}
